# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and is loaded by `next dev`, `next build` and `next start`.

# Clerk keys: https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cmVuZXdlZC13YXNwLTQzLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_your_secret_key

# Postgres database for products, orders and photos.
# On Vercel: Storage → Create Database → Neon adds this automatically.
# Leave it unset locally to use a built-in development database stored in .data/
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Who can open /admin (comma-separated, verified Clerk emails). Defaults to ph.bui07@gmail.com
# ADMIN_EMAILS=ph.bui07@gmail.com

# Optional card payments. Without these, card payment simply isn't offered.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: the old admin's API, only used by "Import from the old admin" in /admin/settings
NEXT_PUBLIC_API_URL=https://tinimart-admin.vercel.app/api/Rn5NXZ1yMqNc3oF6tMO2
